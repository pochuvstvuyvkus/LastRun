-- Шипастая решётка: рама, прутья, два ряда шипов вперёд
SPECS.grill_spike = function()
	local frame = rgb(80, 80, 86)
	local parts = {
		B(V(3, 0.18, 0.2), V(0, 0.5, 0), frame, METAL),
		B(V(3, 0.18, 0.2), V(0, -0.5, 0), frame, METAL),
		B(V(0.6, 0.3, 0.04), V(0.6, 0.1, 0.08), RUSTC, RUST),
