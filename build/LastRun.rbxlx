		CY(0.04, 0.06, V(0, 0.36, 0), gold, METAL),
		B(V(0.03, 0.12, 0.03), V(0.02, 0.44, 0), gold, METAL, V(0, 0, 20)),
		B(V(0.03, 0.12, 0.03), V(0.06, 0.55, 0), gold, METAL, V(0, 0, -20)),
	}
	for i = 0, 3 do
