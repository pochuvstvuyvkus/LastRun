SPECS.grill_saw = function()
	local frame = rgb(96, 96, 100)
	local parts = {
		B(V(3, 0.18, 0.2), V(0, 0.55, 0.1), frame, METAL),
		B(V(3, 0.18, 0.2), V(0, -0.55, 0.1), frame, METAL),
