	local car = carWreck(m, cf, rng, rgb(180, 180, 184))
	deco(car, V3(1.2, 0.4, 0.8), cf * CF(-0.8, 4.7, 0.8), rgb(150, 30, 30), M.Glass)
	deco(car, V3(1.2, 0.4, 0.8), cf * CF(0.8, 4.7, 0.8), rgb(30, 50, 150), M.Glass)
