	cypress = { h = { 24, 38 }, reach = 0.2, low = 0.55, cost = { 3, 4, 10 },
		build = function(p, cf, h, rng, lod) return cypressTree(p, cf, h, rng, { lod = lod, moss = true }) end },
	snag = { h = { 6, 14 }, reach = 0.2, low = 0.5, cost = { 2, 3, 4 },
